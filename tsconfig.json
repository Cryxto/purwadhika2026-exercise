{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Environment: one config covers browser (Vite) and Node (tsx, tsdown) code
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",

    // Modules: Vite, tsdown and tsx do the emitting, `tsc` only type-checks
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "noEmit": true,

    // Type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,

    // Effect diagnostics, completions and refactors (applied by `effect-tsgo patch`)
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "unstableApiUsage": "off",
          "schemaNumber": "off",
          "schemaClassMissingBrand": "off"
        }
      }
    ]
  },
  "include": ["src", "*.config.ts"]
}
